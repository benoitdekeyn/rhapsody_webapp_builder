{
  // Settings shared by rhapsody_API_build (executable + API) and rhapsody_WEB_interface (site).
  // Paths are relative to this file.

  // Folder generated by Rhapsody (.h/.cpp + .mak). Empty: use the one of rhapsody_API_build/rhapsody-api.config.jsonc
  "codeDir": "../E4SE_TD_TP/systemes_evenements_discrets/Rhapsody_v9.0.2/Projet_TABDK_E4SE/CodesGeneres/ModeAnimation",

  // Address the website reads the API at. The executable is built to listen on it.
  "api": {
    "host": "127.0.0.1",
    "port": 8080,
    "token": ""
  },

  // URL prefixes served by the executable: http://<host>:<port><route>/
  "routes": {
    "custom": "/custom",   // the website (custom_web_interface)
    "simple": "/api"       // simple page listing every attribute / event
  },

  // Folder receiving the final executable with everything it needs (web, schemas, assets)
  "outputDir": "./application",
  "exeName": "simulateur.exe",

  // Defaults of rhapsody_WEB_interface/site.config.jsonc, overridden at build time
  "site": {
    "title": "Simulateur véhicule",
    "reconnectMs": 1000,
    "theme": "dark",       // "dark" | "light"
    "showDebug": false
  },

  "smokeTest": true,

  // Sub-projects
  "apiBuild": {
    "dir": "./rhapsody_API_build",
    "config": "rhapsody-api.config.jsonc"
  },
  "webInterface": {
    "dir": "./rhapsody_WEB_interface",
    "dist": "dist",                                          // build output, relative to dir
    "target": "./rhapsody_API_build/custom_web_interface"    // receives the content of dist (+ site.json)
  }
}
