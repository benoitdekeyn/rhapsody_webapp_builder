{
  // ============================================================================
  // CONFIGURATION DU GÉNÉRATEUR D'EXÉCUTABLE & API (rhapsody_API_build)
  // ============================================================================
  // Ce fichier pilote uniquement la compilation du code C++ Rhapsody en exécutable
  // Windows autonome doté d'une API REST + WebSocket.
  //
  // Les chemins ci-dessous sont un EXEMPLE CONCRET (projet personnel véhicule E4SE).
  // Pour votre propre projet Rhapsody, adaptez les champs marqués [À ADAPTER].
  // Note : si vous lancez le build depuis la racine (npm run build), les clés
  // "projectDir", "codeDir", "attributeOverrides", "api" et "routes" de
  // rhapsody-webapp.config.jsonc surchargent celles-ci.

  // [À ADAPTER] Dossier racine de votre projet Rhapsody (optionnel ; sert de base à codeDir et assets.from).
  "projectDir": "../../E4SE_TD_TP/systemes_evenements_discrets/Rhapsody_v9.0.2/Projet_TABDK_E4SE",

  // [À ADAPTER] Dossier contenant le code C++ généré par Rhapsody (.h, .cpp, .mak).
  "codeDir": "CodesGeneres/ModeAnimation",

  // Chemin et nom de l'exécutable produit (relatif à ce fichier).
  "exe": "./dist/simulateur.exe",

  // Export des schémas JSON décrivant l'API (classes, attributs, événements).
  "schema": {
    // Dossier des schémas horodatés (si vide : dossier "schemas" à côté de l'exécutable).
    "dir": "./dist/schemas",
    // Fichiers créés sous la forme <baseName>.<AAAAMMJJ-HHMMSS>.json (jamais écrasés).
    "baseName": "api_schema"
  },

  // Paramètres du serveur HTTP + WebSocket embarqué dans l'exécutable.
  "server": {
    "host": "127.0.0.1",   // "127.0.0.1" = local uniquement ; "0.0.0.0" = réseau local
    "port": 8080,          // 0 désactive complètement le serveur API
    "pushRateHz": 20,      // Fréquence maximale d'envoi des mises à jour WebSocket (en Hz)
    "cors": true,          // Autorise les requêtes depuis n'importe quelle page web (même en file://)
    "token": ""            // Si non vide : clé exigée via ?token=... ou en-tête "Authorization: Bearer ..."
  },

  // Page web générique intégrée : liste automatiquement tous les attributs et événements du modèle.
  "web": {
    "source": "./api_web_interface",  // Dossier source (mettre "" pour désactiver)
    "dir": "api_web_interface",       // Nom du dossier copié à côté de l'exécutable
    "route": "/api"                   // Servi sur http://<host>:<port>/api/ (les routes REST /api/* restent actives)
  },

  // Votre propre site web (HTML, CSS, JS, images...). Placez vos fichiers dans "source" :
  // l'exécutable les copiera et les servira sur "route".
  // Un fichier optionnel "site.json" ({ "api": { "host", "port", "token" } }) dans "source"
  // aligne automatiquement l'adresse d'écoute de l'exécutable sur celle attendue par le site.
  "customWeb": {
    "source": "./custom_web_interface",
    "dir": "custom_web_interface",
    "route": "/custom",               // Servi sur http://<host>:<port>/custom/ ; "/" y redirige automatiquement
    "siteConfig": "site.json"
  },

  // Dossiers supplémentaires recevant une copie complète du dossier de l'exécutable en fin de build.
  "copyTo": [],

  // [Optionnel] Éléments internes du modèle à masquer de l'API.
  // Syntaxe acceptée : "MaClasse.monAttribut", "monAttribut" (toutes classes), jokers * et ?.
  "exclude": {
    "classes": [],
    "attributes": [],
    "events": []
  },

  // [Optionnel] Attributs exposés en lecture seule (l'API refusera toute écriture dessus).
  "readOnly": [],

  // [Optionnel] Alias de types C++ personnalisés vers un type simple compris par l'API.
  // Exemple : { "T_Vitesse": "float", "T_Etat": "int" }
  "typeMap": {},

  // [Optionnel] Surcharge d'initialisations d'attributs dans les constructeurs (copie de travail uniquement).
  // Exemple : [{ "class": "MaClasse", "attribute": "dossier_sons", "type": "OMString", "value": "sons\\" }]
  "attributeOverrides": [],

  // [À ADAPTER — optionnel] Fichiers ou dossiers externes à copier à côté de l'exécutable.
  // Exemple ici : le projet véhicule utilise un dossier "sons" pour jouer des fichiers .wav.
  // Mettez [] si votre projet n'a pas de ressources externes à embarquer.
  "assets": [
    { "from": "sons", "to": "sons" }
  ],

  // Options de compilation MSVC + Framework Rhapsody (détectés automatiquement dans la plupart des cas).
  "build": {
    "workDir": "./build/work",     // Copie de travail où le code C++ est instrumenté (le projet source n'est jamais touché)
    "buildType": "Debug",          // "Debug" ou "Release" (selon les bibliothèques Rhapsody installées sur le PC)
    "instrumentation": "None",     // "None" (autonome) ou "Animation" (lie les libs d'animation Rhapsody)
    "extraDefines": [],            // Macros C++ supplémentaires (-D...)
    "extraIncludes": [],           // Dossiers d'en-têtes (.h) supplémentaires
    "extraLibs": [],               // Bibliothèques .lib supplémentaires
    "extraCompilerFlags": [],      // Options cl.exe supplémentaires
    "extraLinkerFlags": [],        // Options link.exe supplémentaires
    "excludeSources": [],          // Fichiers .cpp du dossier généré à exclure de la compilation
    "vcvarsPath": "",              // Chemin vers vcvars64.bat (vide = détection automatique via Visual Studio)
    "rhapsodyRoot": "",            // Chemin OMROOT (vide = lu automatiquement depuis le .mak de Rhapsody)
    "frameworkLibRoot": "",        // Chemin FRAMEWORK_LIB_ROOT (vide = lu depuis le .mak)
    "libPrefix": "",               // Préfixe des libs Rhapsody (vide = lu depuis le .mak)
    "keepWorkDir": true,           // Conserve build/work après compilation (utile pour déboguer)
    "smokeTest": true,             // Exécute un test de fumée automatique après compilation
    "smokeTestTimeoutSec": 20      // Délai maximal du test de fumée (en secondes)
  },

  // Options d'exécution de l'exécutable généré.
  "run": {
    "cwd": "",                     // Répertoire courant au lancement via CLI (vide = dossier de l'exe)
    "args": [],                    // Arguments passés en ligne de commande
    "useExeDir": true              // Force le dossier de l'exe comme répertoire courant (recommandé si vous utilisez "assets")
  }
}
