{
  // Folder generated by Rhapsody (contains the .h/.cpp and the .mak)
  "codeDir": "../../E4SE_TD_TP/systemes_evenements_discrets/Rhapsody_v9.0.2/Projet_TABDK_E4SE/CodesGeneres/ModeAnimation",

  // Executable to produce (relative to this file)
  "exe": "./dist/simulateur.exe",

  "schema": {
    // Folder of the timestamped schemas (default: "schemas" next to the exe)
    "dir": "./dist/schemas",
    // Files are named <baseName>.<YYYYMMDD-HHMMSS>.json and never overwritten
    "baseName": "api_schema"
  },

  "server": {
    "host": "127.0.0.1",   // "0.0.0.0" to expose on the network
    "port": 8080,          // 0 disables the server
    "pushRateHz": 20,      // max rate of WebSocket deltas
    "cors": true,
    "token": ""            // non-empty: required as ?token= or "Authorization: Bearer"
  },

  "web": {
    "source": "./api_web_interface",  // simple page listing all attributes/events, copied next to the exe
    "dir": "api_web_interface",
    "route": "/api"                   // served at <host>:<port>/api/ (REST /api/* keeps working)
  },

  // Your own website (html, css, js, media, sub-folders...). Put it in this folder; the optional
  // site.json inside it ({ "api": { "host", "port", "token" } }) defines the API address the site reads:
  // the executable is built to listen there. site.json itself is not copied to the executable.
  "customWeb": {
    "source": "./custom_web_interface",
    "dir": "custom_web_interface",
    "route": "/custom",               // served at <host>:<port>/custom/ ; "/" is redirected to it
    "siteConfig": "site.json"
  },

  // Extra folders receiving a full copy of the exe folder (exe, web UIs, schemas, assets)
  "copyTo": [],

  // Internal members to hide from the API. "Class.attr", "attr" (any class), * and ? wildcards.
  "exclude": {
    "classes": [],
    "attributes": [],
    "events": []
  },

  // Attributes exposed read-only
  "readOnly": [],

  // Extra type aliases, e.g. { "MyInt": "int" }
  "typeMap": {},

  // Files copied next to the exe, e.g. { "from": "../Projet_TABDK_E4SE/media", "to": "../media" }
  "assets": [],

  "build": {
    "workDir": "./build/work",
    "buildType": "Debug",          // only Debug framework libs are installed here
    "instrumentation": "None",     // "Animation" links the Rhapsody animation libs
    "extraDefines": [],
    "extraIncludes": [],
    "extraLibs": [],
    "extraCompilerFlags": [],
    "extraLinkerFlags": [],
    "excludeSources": [],
    "vcvarsPath": "",              // auto-detected with vswhere
    "rhapsodyRoot": "",            // default: OMROOT of the .mak
    "frameworkLibRoot": "",        // default: FRAMEWORK_LIB_ROOT of the .mak
    "libPrefix": "",
    "keepWorkDir": true,
    "smokeTest": true,
    "smokeTestTimeoutSec": 20
  },

  "run": {
    "cwd": "",                     // default: folder of the exe
    "args": []
  }
}
