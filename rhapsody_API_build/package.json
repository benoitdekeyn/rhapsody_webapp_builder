{
  "name": "rhapsody-api-build",
  "version": "1.0.0",
  "description": "Turns Rhapsody generated C++ code into a Windows executable exposing an HTTP/WebSocket API",
  "private": true,
  "bin": { "rhapsody-api-build": "src/cli.js" },
  "scripts": {
    "build": "node src/cli.js build",
    "schema": "node src/cli.js schema",
    "run": "node src/cli.js run",
    "clean": "node src/cli.js clean",
    "test": "node --test test/unit.test.js test/e2e.test.js"
  },
  "engines": { "node": ">=22" }
}
