{
  // Link between the names used by the web interface (left) and the identifiers of the Rhapsody model exposed by the API (right).
  // If you rename an attribute or an event in Rhapsody, only change the "api" value / the event string here.
  //   type    : number | boolean | string | list   (how the value is read)
  //   default : value shown while the API does not provide it (optional)

  "attributes": {
    // Dashboard
    "speed":           { "api": "float_speed", "type": "number" },
    "speedInteger":    { "api": "speed", "type": "number" },
    "distance":        { "api": "distance", "type": "number" },
    "maxSpeed":        { "api": "PARAM_SIMU_max_speed", "type": "number", "default": 120 },
    "fuel":            { "api": "reservoir_carburant", "type": "number" },
    "battery":         { "api": "niveau_batterie", "type": "number" },
    "fuelLow":         { "api": "carburant_faible", "type": "boolean" },
    "batteryLow":      { "api": "batterie_faible", "type": "boolean" },
    "fuelThreshold":   { "api": "SEUIL_carburant", "type": "number", "default": 5 },
    "batteryThreshold":{ "api": "SEUIL_batterie", "type": "number", "default": 40 },

    // Ignition and pedals
    "contact":         { "api": "cmd_contact", "type": "boolean" },
    "engine":          { "api": "ignition", "type": "boolean" },
    "throttle":        { "api": "throttle", "type": "number" },
    "slope":           { "api": "alpha", "type": "number" },                 // road slope, -20..20
    "accel":           { "api": "accelPedal", "type": "number" },
    "brake":           { "api": "brakePedal", "type": "number" },

    // Cruise control / speed limiter
    "cruise":          { "api": "voyant_regulateur", "type": "boolean" },
    "limiter":         { "api": "voyant_limiteur", "type": "boolean" },
    "limiterWaiting":  { "api": "limiteur_attente", "type": "boolean" },
    "limiterExceeded": { "api": "limiteur_depasse", "type": "boolean" },
    "setpoint":        { "api": "vitesseConsigne", "type": "number" },
    "initialLimit":    { "api": "valeur_initiale_limiteur", "type": "number", "default": 50 },

    // Vehicle ahead simulation
    "vehicleAheadSpeed":      { "api": "vitesse_voiture_devant", "type": "number" },
    "vehicleAheadDistance":   { "api": "distance_voiture_devant", "type": "number" },
    "vehicleAheadDistanceInt":{ "api": "distance_entiere_voiture_devant", "type": "number" },
    "interVehicleDistance":   { "api": "distance_inter_voiture", "type": "number" },
    "safetyDistance":         { "api": "distance_securite", "type": "number", "default": 30 },
    "vehicleAheadSimulation": { "api": "cmd_simulation_voiture_devant", "type": "boolean" },

    // Hands-free kit and phone
    "vehicleBluetooth":{ "api": "VOYANT_bluetooth_vehicule", "type": "boolean" },
    "vehicleConnected":{ "api": "VOYANT_kit_connecte", "type": "boolean" },
    "phoneConnected":  { "api": "VOYANT_telephone_connecte", "type": "boolean" },
    "phoneBluetooth":  { "api": "cmd_bluetooth_telephone_actif", "type": "boolean" },
    "phoneBattery":    { "api": "niveau_batterie_telephone", "type": "number" },
    "charging":        { "api": "cmd_charge_vehicule_telephone", "type": "boolean" },
    "call":            { "api": "VOYANT_kit_appel", "type": "boolean" },
    "sms":             { "api": "VOYANT_kit_sms", "type": "boolean" },
    "pin":             { "api": "mot_de_passe", "type": "string" },
    "pinInput":        { "api": "champ_mdp", "type": "string" },
    "deviceList":      { "api": "affichage_liste_appareils", "type": "string" },
    "pairingMessage":  { "api": "affichage_appairage", "type": "string" },
    "messages":        { "api": "messages_appairage", "type": "list" },

    // Radio, calls and SMS
    "radioIndicator":  { "api": "VOYANT_radio", "type": "boolean" },
    "musicTitle":      { "api": "affichage_titre_musique", "type": "string" },
    "radioOn":         { "api": "cmd_radio", "type": "boolean" },
    "ringing":         { "api": "sonnerie_en_cours", "type": "boolean" },
    "phoneCall":       { "api": "VOYANT_telephone_appel", "type": "boolean" },
    "phoneSms":        { "api": "VOYANT_telephone_sms", "type": "boolean" },
    "phoneRinging":    { "api": "VOYANT_telephone_sonnerie", "type": "boolean" },
    "vehicleRinging":  { "api": "VOYANT_kit_sonnerie", "type": "boolean" },
    "phoneCallActive": { "api": "appel_en_cours_telephone", "type": "boolean" },
    "phoneSavedSmsCount": { "api": "nbr_sauvegarde_sms_telephone", "type": "number" },
    "kitSmsCount":     { "api": "nbr_sms_kit", "type": "number" },
    "phoneSmsCount":   { "api": "nbr_sms_telephone", "type": "number" },
    "kitBatteryLevel": { "api": "niveau_batterie_kit", "type": "number" },
    "phoneOn":         { "api": "telephone_allume", "type": "boolean" },

    // Simulation parameters (parameters menu)
    "mass":            { "api": "PARAM_SIMU_masse", "type": "number" },
    "airDrag":         { "api": "PARAM_SIMU_frottement_air", "type": "number" },
    "enginePower":     { "api": "PARAM_SIMU_puissance_moteur", "type": "number" },
    "brakePower":      { "api": "PARAM_SIMU_puissance_frein", "type": "number" },
    "restSpeed":       { "api": "PARAM_SIMU_vitesse_repos", "type": "number" },
    "maxAccel":        { "api": "PARAM_SIMU_max_accel", "type": "number" },
    "maxBrake":        { "api": "PARAM_SIMU_max_brake", "type": "number" },
    "maxThrottle":     { "api": "PARAM_SIMU_max_throttle", "type": "number", "default": 10 },
    "kp":              { "api": "PARAM_SIMU_Kp_regulateur", "type": "number" },
    "ki":              { "api": "PARAM_SIMU_Ki_regulateur", "type": "number" },
    "regulatorFreq":   { "api": "PARAM_SIMU_freq_regulateur", "type": "number" },
    "refreshFreq":     { "api": "PARAM_SIMU_freq_rafraichissement", "type": "number" }
  },

  "events": {
    "start":        "ev_demarrer",
    "cruise":       "ev_regulateur",
    "limiter":      "ev_limiteur",
    "setpointPlus": "ev_vitesseConsigne_plus",
    "setpointMinus":"ev_vitesseConsigne_moins",
    "refuel":       "ev_remplir_carburant",
    "jumpStart":    "ev_depanner_batterie",
    "selectDevice": "ev_btn_ok",
    "pair":         "ev_jumeler",

    // User actions and simulated incoming calls / SMS
    "radioSkip":       "ev_btn_radio_skip",
    "radioPlay":       "ev_btn_start_radio",
    "incomingCall":    "ev_btn_SIM_appel",
    "incomingSms":     "ev_btn_SIM_sms",
    "phoneAnswer":     "ev_btn_telephone_decrocher",
    "phoneHangUp":     "ev_btn_telephone_raccrocher",
    "kitAnswerButton": "ev_btn_kit_decrocher",
    "kitHangUpButton": "ev_btn_kit_raccrocher",
    "phoneReadSms":    "ev_btn_telephone_lire_sms",
    "kitReadSms":      "ev_btn_kit_lire_sms",

    // Internal statechart events; the three SMS synchronization events carry an argument.
    "skipMusic":           "ev_skip_musique",
    "kitRing":             "ev_kit_sonnerie",
    "ringFinished":        "ev_kit_fin_sonnerie",
    "callRejected":        "ev_SIM_raccrocher",
    "externalCall":        "ev_SIM_appel",
    "kitHangUp":           "ev_kit_raccrocher",
    "kitAnswer":           "ev_kit_decrocher",
    "kitIncomingCall":     "ev_kit_appel_entrant",
    "kitCallTransferred":  "ev_kit_appel_transfere",
    "kitCallFinished":     "ev_kit_appel_termine",
    "callInProgress":      "ev_SIM_appel_en_cours",
    "deliverSms":          "ev_SIM_envoi_sms",
    "readSmsOnKit":        "ev_kit_lire_sms",
    "transferSmsToKit":    "ev_transfert_sms_to_kit",
    "tryReadSmsOnKit":     "ev_tentative_lire_sms_kit",
    "newSmsOnKit":         "ev_nv_sms_kit",
    "refreshKitSms":       "ev_actualisation_sms_kit"
  },

  // Content of the "Paramètres" menu: each key must exist in "attributes".
  "parameters": [
    {
      "group": "Véhicule",
      "items": [
        { "key": "mass", "label": "Masse", "unit": "kg", "step": 10 },
        { "key": "airDrag", "label": "Frottement de l'air", "step": 1 },
        { "key": "enginePower", "label": "Puissance moteur", "step": 50 },
        { "key": "brakePower", "label": "Puissance de freinage", "step": 10 },
        { "key": "maxSpeed", "label": "Vitesse maximale", "unit": "km/h", "step": 5 },
        { "key": "restSpeed", "label": "Vitesse au ralenti", "unit": "km/h", "step": 1 },
        { "key": "maxAccel", "label": "Accélérateur max", "step": 1 },
        { "key": "maxBrake", "label": "Frein max", "step": 1 },
        { "key": "maxThrottle", "label": "Papillon max", "step": 0.5 }
      ]
    },
    {
      "group": "Régulateur / limiteur",
      "items": [
        { "key": "initialLimit", "label": "Consigne initiale du limiteur", "unit": "km/h", "step": 5 },
        { "key": "kp", "label": "Kp", "step": 0.1 },
        { "key": "ki", "label": "Ki", "step": 0.1 },
        { "key": "regulatorFreq", "label": "Fréquence du régulateur", "step": 1 },
        { "key": "refreshFreq", "label": "Fréquence de rafraîchissement", "step": 1 }
      ]
    },
    {
      "group": "Énergie",
      "items": [
        { "key": "fuel", "label": "Niveau de carburant", "unit": "L", "step": 1 },
        { "key": "battery", "label": "Niveau de batterie", "unit": "%", "step": 1 },
        { "key": "fuelThreshold", "label": "Seuil carburant faible", "unit": "L", "step": 1 },
        { "key": "batteryThreshold", "label": "Seuil batterie faible", "unit": "%", "step": 1 }
      ]
    },
    {
      "group": "Kit mains libres",
      "items": [
        { "key": "pin", "label": "Mot de passe du kit" }
      ]
    }
  ]
}
